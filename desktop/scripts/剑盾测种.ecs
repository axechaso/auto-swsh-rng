# PySide6 兼容版：原稿保存在 originals/，改动见 README.md
# 唤醒设备
FOR 5
    LCLICK 120
    WAIT 100
NEXT

HOME 200
WAIT 1200
X 200
$3 = 0
FOR
    $1 = @YY
    IF $1 > 90
        BREAK
    ELSE
        A
        WAIT 1000
        $3 += 1    #每秒按一次A键，同时$3的值+1
        IF $3 > 60    #连A超过60秒判定为掉线
            PRINT 疑似掉线
            HOME 200
            WAIT 2000
            X
            WAIT 100
            $3 = 0
        ENDIF
    ENDIF
NEXT
WAIT 1000
X 200
WAIT 1500
RIGHT 200
WAIT 400
A 200
WAIT 2000
DOWN 200
WAIT 1000
$4 = 128
$测种序列 = ""
FOR $4
    RCLICK
    WAIT 1000
    $2 = @铁甲物理
    IF $2 > 80
        $测种序列 = $测种序列 & "0"
        WAIT 400
    ELSE
        $测种序列 = $测种序列 & "1"
        WAIT 650
    ENDIF
NEXT
PRINT $测种序列  # 一次输出完整 128 位，避免旧版续行差异
