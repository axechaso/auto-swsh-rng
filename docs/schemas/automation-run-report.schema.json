{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-swsh-rng.local/schemas/automation-run-report.schema.json",
  "title": "Auto SWSH automation run report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schemaVersion", "generatedAtUtc", "runId", "scenarioId",
    "contextRevision", "executionMode", "outcomeType", "sourceKind",
    "algorithmCommit", "scriptRevision", "frameworkStatus", "hardwareStatus",
    "status", "phase", "reason", "searchRange",
    "searchFilters", "epochs", "candidateRows", "candidateRowsTruncated",
    "targetSnapshotId", "targetRequestDigest", "searchOrderVersion",
    "totalEvents", "eventHistoryTruncated", "events", "limitations"
  ],
  "properties": {
    "schema": {"const": "auto-swsh-automation-run-report"},
    "schemaVersion": {"const": 1},
    "generatedAtUtc": {"type": "string", "format": "date-time"},
    "runId": {"type": "string", "minLength": 1},
    "scenarioId": {"type": "string", "minLength": 1},
    "contextRevision": {"type": "integer", "minimum": 0},
    "executionMode": {"const": "simulation"},
    "outcomeType": {"const": "simulation_search_only"},
    "sourceKind": {"const": "synthetic"},
    "algorithmCommit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "scriptRevision": {"type": "string", "minLength": 1},
    "frameworkStatus": {"enum": ["NotImplemented", "FrameworkReady"]},
    "hardwareStatus": {
      "enum": ["PendingHardwareValidation", "HardwareValidated", "HardwareValidationFailed"]
    },
    "status": {"enum": ["targets_found", "cancelled", "needs_attention", "failed"]},
    "phase": {
      "enum": ["preflight", "restore_scene", "observe_seed", "verify_seed", "search_targets", "restart", "cleanup"]
    },
    "reason": {"type": ["string", "null"]},
    "searchRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      }
    },
    "searchFilters": {"type": "object"},
    "epochs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "epochId", "seed0", "seed1", "observationBits", "verificationBits",
          "searchedPositions", "searchedStart", "searchedEnd", "candidateCount",
          "candidateRowsTruncated", "targetSnapshotId", "targetRequestDigest", "searchOrderVersion"
        ],
        "properties": {
          "epochId": {"type": "string", "minLength": 1},
          "seed0": {"type": "string", "pattern": "^[0-9A-Fa-f]{16}$"},
          "seed1": {"type": "string", "pattern": "^[0-9A-Fa-f]{16}$"},
          "observationBits": {"const": 128},
          "verificationBits": {"const": 128},
          "searchedPositions": {"type": "integer", "minimum": 0},
          "searchedStart": {"type": ["integer", "null"], "minimum": 0},
          "searchedEnd": {"type": ["integer", "null"], "minimum": 0},
          "candidateCount": {"type": "integer", "minimum": 0},
          "candidateRowsTruncated": {"type": "boolean"},
          "targetSnapshotId": {"type": ["string", "null"]},
          "targetRequestDigest": {"type": ["string", "null"]},
          "searchOrderVersion": {"type": ["string", "null"]}
        }
      }
    },
    "candidateRows": {"type": "array", "items": {"type": "object"}},
    "candidateRowsTruncated": {"type": "boolean"},
    "targetSnapshotId": {"type": ["string", "null"]},
    "targetRequestDigest": {"type": ["string", "null"]},
    "searchOrderVersion": {"type": ["string", "null"]},
    "totalEvents": {"type": "integer", "minimum": 0},
    "eventHistoryTruncated": {"type": "boolean"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "epochId", "phase", "message", "timestampMonotonicNs", "details"],
        "properties": {
          "runId": {"type": "string", "minLength": 1},
          "epochId": {"type": ["string", "null"]},
          "phase": {
            "enum": ["preflight", "restore_scene", "observe_seed", "verify_seed", "search_targets", "restart", "cleanup"]
          },
          "message": {"type": "string"},
          "timestampMonotonicNs": {"type": "integer", "minimum": 0},
          "details": {"type": "object"}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
