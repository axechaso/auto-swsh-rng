  "properties": {
    "schema": { "const": "auto-swsh-feedback-archive" },
    "schemaVersion": { "const": 1 },
    "archiveRevision": { "type": "integer", "minimum": 0 },
    "contextFingerprint": { "type": ["string", "null"] },
    "boundaryModel": { "type": ["object", "null"] },
    "timingModel": { "type": ["object", "null"] },
    "retryWorkflow": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
