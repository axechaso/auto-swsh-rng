{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-swsh-rng.local/schemas/evidence-manifest.schema.json",
  "title": "Auto SWSH RNG scenario evidence manifest",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "scenarioId",
    "scenarioRevision",
    "frameworkStatus",
    "hardwareStatus",
    "algorithmCommit",
    "scriptRevision",
    "deviceProfile",
    "requiredCases",
    "frameworkValidationCases",
    "evidence",
    "reviewedAtUtc",
    "reviewedBy"
  ],
  "properties": {
    "schema": { "const": "auto-swsh-evidence-manifest" },
    "schemaVersion": { "const": 1 },
    "scenarioId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
    "scenarioRevision": { "type": "integer", "minimum": 1 },
    "frameworkStatus": { "enum": ["NotImplemented", "FrameworkReady"] },
    "hardwareStatus": {
      "enum": ["PendingHardwareValidation", "HardwareValidated", "HardwareValidationFailed"]
    },
    "algorithmCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "scriptRevision": { "type": "string", "minLength": 1 },
    "deviceProfile": { "type": ["object", "null"] },
    "requiredCases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }
    },
    "frameworkValidationCases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "reviewedAtUtc": { "type": ["string", "null"], "format": "date-time" },
    "reviewedBy": { "type": ["string", "null"] }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "required": [
        "evidenceId",
        "caseId",
        "kind",
        "sourceKind",
        "path",
        "sha256",
        "sizeBytes",
        "capturedAtUtc",
        "metadata",
        "versionFingerprint"
      ],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "caseId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "kind": {
          "enum": ["image", "video", "frame_replay", "action_log", "experiment_report"]
        },
        "sourceKind": { "enum": ["real", "synthetic", "replay", "report"] },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "capturedAtUtc": { "type": ["string", "null"], "format": "date-time" },
        "metadata": { "type": "object" },
        "versionFingerprint": {
          "type": "object",
          "required": ["algorithmCommit", "scriptRevision", "deviceProfileSha256"],
          "properties": {
            "algorithmCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
            "scriptRevision": { "type": "string", "minLength": 1 },
            "deviceProfileSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    }
  }
}
