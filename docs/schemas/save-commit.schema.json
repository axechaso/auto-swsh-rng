{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-swsh-rng.local/schemas/save-commit.schema.json",
  "title": "Auto SWSH RNG save commit",
  "type": "object",
  "required": [
    "schema", "schemaVersion", "runId", "epochId", "attemptId", "stage",
    "targetIdentity", "targetSlot", "targetEvidenceIds", "algorithmCommit",
    "scriptRevision", "createdAtUtc", "updatedAtUtc", "saveEvidenceIds", "receipt"
  ],
  "properties": {
    "schema": { "const": "auto-swsh-save-commit" },
    "schemaVersion": { "const": 2 },
    "runId": { "type": "string", "minLength": 1 },
    "epochId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["SuccessDetected", "SaveRequested", "SaveConfirmed", "Completed"] },
    "targetIdentity": { "type": "string", "minLength": 1 },
    "targetSlot": { "type": "string", "minLength": 1 },
    "targetEvidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "algorithmCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "scriptRevision": { "type": "string", "minLength": 1 },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "updatedAtUtc": { "type": "string", "format": "date-time" },
    "saveEvidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "receipt": { "$ref": "#/$defs/saveReceipt" }
  },
  "$defs": {
    "saveReceipt": {
      "type": ["object", "null"],
      "required": ["attemptId", "targetIdentity", "targetSlot", "savePageEvidenceId", "postSaveIdentity", "postSaveIdentityEvidenceIds", "algorithmCommit", "scriptRevision", "confirmedAtUtc"],
      "properties": {
        "attemptId": { "type": "string", "minLength": 1 },
        "targetIdentity": { "type": "string", "minLength": 1 },
        "targetSlot": { "type": "string", "minLength": 1 },
        "savePageEvidenceId": { "type": "string", "minLength": 1 },
        "postSaveIdentity": { "type": "string", "minLength": 1 },
        "postSaveIdentityEvidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "algorithmCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "scriptRevision": { "type": "string", "minLength": 1 },
        "confirmedAtUtc": { "type": "string", "format": "date-time" }
      }
    }
  }
}
